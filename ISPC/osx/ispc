build_ispc() {
    SRC="$1"
    NAME="$2"

    mkdir -p "${OUT}/arm64"
    mkdir -p "${OUT}/x86_64"

    "${ISPC}" \
        --arch=arm64 \
        --target=neon-i32x4 \
        -O2 \
        --opt=fast-math \
        "${SRC}" \
        -o "${OUT}/arm64/${NAME}.o"

    "${ISPC}" \
        --arch=x86-64 \
        --target=sse2,avx \
        -O2 \
        --opt=fast-math \
        "${SRC}" \
        -o "${OUT}/x86_64/${NAME}.o"

    lipo \
        -create \
        "${OUT}/arm64/${NAME}.o" \
        "${OUT}/x86_64/${NAME}.o" \
        -output "${OUT}/${NAME}.o"
}

build_ispc \
    "path/to/kernel.ispc" \
    "kernel"

build_ispc \
    "path/to/kernel_astc.ispc" \
    "kernel_astc"
