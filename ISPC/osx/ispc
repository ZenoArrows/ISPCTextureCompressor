build_ispc() {
    SRC="$1"
    NAME="$2"

    ispc \
        --arch=arm64 \
        --target=neon-i32x4 \
        -O2 \
        --opt=fast-math \
        "${SRC}" \
        -o "$OBJROOT/${NAME}-arm64.o"

    ispc \
        --arch=x86-64 \
        --target=sse2,avx \
        -O2 \
        --opt=fast-math \
        "${SRC}" \
        -o "$OBJROOT/${NAME}-x86_64.o"

    lipo \
        -create \
        "$OBJROOT/${NAME}-arm64.o" \
        "$OBJROOT/${NAME}-x86_64.o" \
        -output "$OBJROOT/${NAME}.o"
}

build_ispc \
    "../../ispc_texcomp/kernel.ispc" \
    "kernel"

build_ispc \
    "../../ispc_texcomp/kernel_astc.ispc" \
    "kernel_astc"
